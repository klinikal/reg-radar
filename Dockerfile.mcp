FROM python:3.11-slim

WORKDIR /app

COPY mcpserver/requirements.txt ./mcpserver/requirements.txt
COPY collector/requirements.txt ./collector/requirements.txt
RUN pip install --no-cache-dir -r mcpserver/requirements.txt -r collector/requirements.txt

COPY collector/ ./collector/
COPY mcpserver/ ./mcpserver/

RUN addgroup --system appgroup && \
    adduser --system --ingroup appgroup appuser && \
    chown -R appuser:appgroup /app

USER appuser

ENV DB_PATH=/app/data/casp_radar.db \
    LOG_LEVEL=INFO

CMD ["python", "-m", "mcpserver.server"]
