FROM python:3.11-slim

WORKDIR /app

COPY mcpserver/requirements.txt ./mcpserver/requirements.txt
RUN pip install --no-cache-dir -r mcpserver/requirements.txt

# regradar/ (installed below) imports collector.* modules (storage,
# pipeline, main), so their runtime deps must be installed too - except
# playwright, which is collector-image-only (see Dockerfile.collector).
COPY collector/requirements.txt ./collector/requirements.txt
RUN grep -v '^playwright' collector/requirements.txt | pip install --no-cache-dir -r /dev/stdin

COPY collector/ ./collector/
COPY mcpserver/ ./mcpserver/
COPY regradar/ ./regradar/
COPY pyproject.toml ./pyproject.toml
RUN pip install --no-cache-dir --no-deps .

RUN addgroup --system appgroup && \
    adduser --system --ingroup appgroup appuser && \
    chown -R appuser:appgroup /app

USER appuser

ENV PYTHONPATH=/app \
    DB_PATH=/app/data/regradar.db \
    LOG_LEVEL=INFO

CMD ["python", "-m", "mcpserver.server"]
