FROM python:3.11-slim@sha256:b7a9e5f6a93d6d4a31f129bbd4bdee69efccb6ded0fb230d78aafaf37af98377

WORKDIR /app

# Hashed lock (scripts/relock.sh): webui deps plus the collector deps
# regradar/ imports, minus playwright (collector-image-only).
COPY webui/requirements.lock ./webui/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r webui/requirements.lock

COPY collector/ ./collector/
COPY mcpserver/ ./mcpserver/
COPY webui/ ./webui/
COPY regradar/ ./regradar/
COPY pyproject.toml ./pyproject.toml
RUN pip install --no-cache-dir --no-deps .

RUN addgroup --system appgroup && \
    adduser --system --ingroup appgroup appuser && \
    chown -R appuser:appgroup /app

USER appuser

ENV PYTHONPATH=/app \
    DB_PATH=/app/data/reg_radar.db \
    LOG_LEVEL=INFO

CMD ["uvicorn", "webui.app:app", "--host", "0.0.0.0", "--port", "8080"]
