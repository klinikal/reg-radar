DB_PATH=/app/data/reg_radar.db
SCHEDULE=0 6 * * *
LOG_LEVEL=INFO
USER_AGENT=Mozilla/5.0 (compatible; reg-radar/2.0; +https://github.com/klinikal/reg-radar)
REQUEST_TIMEOUT_SECONDS=30
REQUEST_RETRIES=3
REGULATORS_PATH=/app/config/regulators
TAXONOMY_PATH=/app/config/taxonomy.yaml
JURISDICTIONS_PATH=/app/config/jurisdictions.yaml
ACTIVITIES_PATH=/app/config/activities.yaml
PROFILES_DIR=/app/config/profiles
# FlareSolverr is included in docker-compose.yml by default - this internal
# service address makes it available. Leave blank to disable it (any
# cloudflare_protected regulator will then be skipped, not error).
FLARESOLVERR_URL=http://flaresolverr:8191
# Classification rules (see config/rules.yaml) - path to the rules engine's config file
RULES_PATH=/app/config/rules.yaml
# Batch LLM classifier runner (`reg-radar classify`, see README's
# "Batch LLM classifier runner" section) - only needed for the provider
# you actually use. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PRICES_PATH=/app/config/llm_prices.yaml
# Optional webhook subscribers (see README's "Export and sync" section) -
# a missing file disables webhook delivery entirely, no config needed.
WEBHOOKS_PATH=/app/config/webhooks.yaml
# Optional digests (see README's "Digests" section) - a missing file
# disables digests entirely, no config needed.
DIGESTS_PATH=/app/config/digests.yaml
# SMTP settings for the "email" digest channel - only needed if a digest
# uses one. SMTP_PASSWORD_ENV names the env var holding the password (the
# password itself is never in config), matching the secret_env convention.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD_ENV=
SMTP_FROM=
SMTP_STARTTLS=true
# Telegram bot token for the "telegram" digest channel - only needed if a
# digest uses one. Never put it in digests.yaml.
TELEGRAM_BOT_TOKEN=
# Entries returned by GET /feeds/<profile>.atom
FEED_MAX_ITEMS=50
# Only needed if you remap the MCP server's published port (see README) -
# comma-separated host:port values to add to the Host-header allowlist,
# e.g. MCP_EXTRA_ALLOWED_HOSTS=127.0.0.1:8001,localhost:8001
MCP_EXTRA_ALLOWED_HOSTS=
# When set, the web UI's write routes (classifying an item, adding/deleting
# a rule) require HTTP Basic auth with this value as the password (any
# username). Leave blank for the current default: unauthenticated writes,
# which is only safe while docker-compose.yml keeps the webui port bound to
# 127.0.0.1 (loopback) as it does by default.
WEBUI_AUTH_TOKEN=
