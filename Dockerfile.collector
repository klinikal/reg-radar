FROM python:3.11-slim@sha256:b7a9e5f6a93d6d4a31f129bbd4bdee69efccb6ded0fb230d78aafaf37af98377

WORKDIR /app

COPY collector/requirements.lock ./collector/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r collector/requirements.lock

# Playwright's browser binary (collector/adapters/browser.py) - collector
# image only, not mcp/webui (issue #8: "install it in the collector image
# only"). --with-deps pulls the system libraries Chromium needs; run as
# root, before the appuser switch below, since apt needs root.
ENV PLAYWRIGHT_BROWSERS_PATH=/app/pw-browsers
RUN playwright install --with-deps chromium

COPY collector/ ./collector/
COPY mcpserver/ ./mcpserver/
COPY config/ ./config/
COPY scripts/ ./scripts/
COPY regradar/ ./regradar/
COPY pyproject.toml ./pyproject.toml
RUN pip install --no-cache-dir --no-deps .

RUN mkdir -p /app/data && \
    addgroup --system appgroup && \
    adduser --system --ingroup appgroup appuser && \
    chown -R appuser:appgroup /app

USER appuser

ENV PYTHONPATH=/app \
    DB_PATH=/app/data/reg_radar.db \
    SCHEDULE="0 6 * * *" \
    LOG_LEVEL=INFO \
    REQUEST_TIMEOUT_SECONDS=30 \
    REQUEST_RETRIES=3 \
    REGULATORS_PATH=/app/config/regulators

CMD ["python", "-m", "collector.main"]
