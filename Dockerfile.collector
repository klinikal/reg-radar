FROM python:3.11-slim

WORKDIR /app

COPY collector/requirements.txt ./collector/requirements.txt
RUN pip install --no-cache-dir -r collector/requirements.txt

COPY collector/ ./collector/
COPY config/ ./config/
COPY scripts/ ./scripts/

RUN mkdir -p /app/data && \
    addgroup --system appgroup && \
    adduser --system --ingroup appgroup appuser && \
    chown -R appuser:appgroup /app

USER appuser

ENV DB_PATH=/app/data/regradar.db \
    SCHEDULE="0 6 * * *" \
    LOG_LEVEL=INFO \
    USER_AGENT="regradar/2.0 (+https://github.com/klinikal/regradar)" \
    REQUEST_TIMEOUT_SECONDS=30 \
    REQUEST_RETRIES=3 \
    REGULATORS_PATH=/app/config/regulators.yaml

CMD ["python", "-m", "collector.main"]
